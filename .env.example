# Copy to .env.local and fill in. Never commit real values.
# ---- Used by the code today ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # public base URL (canonical + Open Graph)
NEXT_PUBLIC_SUPABASE_URL=                    # Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=               # same page (anon / publishable key)
SUPABASE_SERVICE_ROLE_KEY=                   # same page. SECRET, server-only, bypasses RLS
RATE_LIMIT_SALT=                             # any long random string (salts hashed IPs)
RESEND_API_KEY=                              # optional: resend.com > API Keys (booking emails)
EMAIL_FROM=                                  # e.g. Name <bookings@yourdomain.com> (verified domain)
BOOKING_NOTIFY_EMAIL=                        # where new inquiries are emailed
# ---- Reserved for later phases (docs/PHASES.md) ----
TOKEN_ENCRYPTION_KEY=                        # 32-byte base64 key for social-token encryption (P5)
CRON_SECRET=                                 # authenticates the publishing scheduler endpoint (P6)
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=                            # YouTube
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
AI_API_KEY=                                  # optional caption assistant
GA4_MEASUREMENT_ID=                          # optional analytics
